---
import EkrLayout from '../../../layouts/EkrLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatCard from '../../../components/StatCard.astro';
import Badge from '../../../components/Badge.astro';
import Icon from '../../../components/Icon.astro';
import Empty from '../../../components/Empty.astro';
import {
  getEkrContext, back, str, oneOf, hoy, diasDesde, promedio, fmtDate, truncar, PRIORIDADES,
} from '../../../lib/ekr';

const ctx = await getEkrContext(Astro);
if (ctx instanceof Response) return ctx;
const { supabase } = ctx;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = str(form, 'intent');
  const id = str(form, 'id');
  if (!id) return back('/ekr/espera', 'error', 'Falta la persona.');

  if (intent === 'admitir') {
    const { error } = await supabase
      .from('beneficiarios')
      .update({ estado: 'activo' })
      .eq('id', id)
      .eq('estado', 'lista_espera');
    if (error) return back('/ekr/espera', 'error', 'No se pudo admitir: ' + error.message);

    const vol = str(form, 'voluntario_id');
    if (vol) {
      const { error: e2 } = await supabase.from('asignaciones').insert({
        voluntaria_id: vol,        // ← corregido (era voluntario_id)
        beneficiario_id: id,
        fecha_inicio: hoy(),
      });
      if (e2) return back('/ekr/espera', 'error', 'Se admitió, pero no se pudo asignar acompañante: ' + e2.message);
    }
    return back('/ekr/espera', 'ok', vol ? 'Persona admitida y con acompañante asignado/a.' : 'Persona admitida. Recuerda asignarle un acompañante.');
  }

  if (intent === 'prioridad') {
    const p = oneOf(str(form, 'prioridad'), ['alta', 'media', 'baja'] as const);
    if (!p) return back('/ekr/espera', 'error', 'Prioridad no válida.');
    const { error } = await supabase.from('beneficiarios').update({ prioridad: p }).eq('id', id);
    if (error) return back('/ekr/espera', 'error', 'No se pudo actualizar: ' + error.message);
    return back('/ekr/espera', 'ok', 'Prioridad actualizada.');
  }
}

const [ben, prof, asig] = await Promise.all([
  supabase.from('beneficiarios').select('*').eq('estado', 'lista_espera'),
  supabase.from('profiles').select('id,nombre,rol,activo'),
  supabase.from('asignaciones').select('voluntaria_id,beneficiario_id').eq('activa', true),
]);

const cargas = new Map<string, number>();
for (const a of asig.data ?? []) {
  cargas.set(a.voluntaria_id, (cargas.get(a.voluntaria_id) ?? 0) + 1);  // ← corregido
}

const voluntarios = (prof.data ?? [])
  .filter((p: any) => p.rol === 'voluntario' && p.activo)
  .sort((a: any, b: any) => (cargas.get(a.id) ?? 0) - (cargas.get(b.id) ?? 0));

// Orden: primero prioridad (alta → baja), luego por fecha de derivación más antigua
const espera = (ben.data ?? []).sort((a: any, b: any) =>
  (PRIORIDADES[a.prioridad as keyof typeof PRIORIDADES]?.orden ?? 1) -
    (PRIORIDADES[b.prioridad as keyof typeof PRIORIDADES]?.orden ?? 1) ||
  (a.fecha_derivacion ?? '').localeCompare(b.fecha_derivacion ?? ''),
);

const altas = espera.filter((b: any) => b.prioridad === 'alta').length;
const dias = espera.map((b: any) => diasDesde(b.fecha_derivacion));  // ← corregido
---

<EkrLayout title="Lista de espera" active="espera" ctx={ctx}>
  <PageHeader title="Lista de espera" subtitle="Ordenada por prioridad y, a igual prioridad, por antigüedad.">
    <a href="/api/ekr/export?hoja=espera" class="btn btn-ghost"><Icon name="file-spreadsheet" size={18} /> Exportar</a>
    <a href="/ekr/beneficiarios/nuevo?estado=lista_espera" class="btn btn-primary"><Icon name="user-plus" size={18} /> Agregar a la lista</a>
  </PageHeader>

  <section class="mb-6 grid gap-4 sm:grid-cols-3" aria-label="Resumen">
    <StatCard label="Personas esperando" value={espera.length} icon="hourglass" tone="taupe" />
    <StatCard label="Prioridad alta" value={altas} hint="Atender primero" icon="triangle-alert" tone={altas ? 'salmon' : 'slate'} />
    <StatCard label="Espera promedio" value={`${Math.round(promedio(dias))} d`} hint={dias.length ? `Máxima: ${Math.max(...dias)} días` : undefined} icon="clock" tone="rose" />
  </section>

  <div class="card">
    {espera.length === 0 ? (
      <Empty icon="circle-check" title="No hay nadie en lista de espera" text="Cuando alguien solicite acompañamiento y no haya cupo, aparecerá aquí." />
    ) : (
      <ul class="divide-y divide-line">
        {espera.map((b: any, i: number) => (
          <li class="grid gap-4 p-5 lg:grid-cols-[2.5rem_1fr_auto] lg:items-center">
            <span class="grid size-9 place-items-center rounded-full bg-rosy-taupe/25 text-sm font-bold text-rose-deep tabular-nums" aria-label={`Posición ${i + 1}`}>{i + 1}</span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <a href={`/ekr/beneficiarios/${b.id}`} class="font-semibold text-ink hover:underline">{b.nombre}</a>
                <Badge tone={PRIORIDADES[b.prioridad as keyof typeof PRIORIDADES]?.tone ?? 'slate'} dot>
                  Prioridad {PRIORIDADES[b.prioridad as keyof typeof PRIORIDADES]?.label?.toLowerCase() ?? 'media'}
                </Badge>
              </div>
              <p class="mt-0.5 text-sm text-blue-slate">
                {b.comuna ?? 'Sin comuna'} · Espera hace {diasDesde(b.fecha_derivacion)} días
                {b.fecha_derivacion ? ` (desde ${fmtDate(b.fecha_derivacion)})` : ''}
                {b.telefono ? ` · ${b.telefono}` : ''}
              </p>
              {b.observaciones_voluntaria && (
                <p class="mt-1 text-sm text-blue-slate/90">{truncar(b.observaciones_voluntaria, 140)}</p>
              )}
            </div>
            <div class="flex flex-wrap items-center gap-2 lg:justify-end">
              <form method="post" class="flex items-center gap-1.5">
                <input type="hidden" name="intent" value="prioridad" />
                <input type="hidden" name="id" value={b.id} />
                <label class="sr-only" for={`pr-${b.id}`}>Prioridad</label>
                <select id={`pr-${b.id}`} name="prioridad" class="input w-auto! py-1.5! text-xs">
                  {Object.entries(PRIORIDADES).map(([k, p]) => (
                    <option value={k} selected={b.prioridad === k}>{p.label}</option>
                  ))}
                </select>
                <button class="btn btn-ghost btn-sm" type="submit">Cambiar</button>
              </form>
              <form method="post" class="flex items-center gap-1.5" data-confirm={`¿Admitir a ${b.nombre} al programa?`}>
                <input type="hidden" name="intent" value="admitir" />
                <input type="hidden" name="id" value={b.id} />
                <label class="sr-only" for={`vol-${b.id}`}>Acompañante</label>
                <select id={`vol-${b.id}`} name="voluntario_id" class="input w-auto! py-1.5! text-xs">
                  <option value="">Sin acompañante aún</option>
                  {voluntarios.map((v: any) => (
                    <option value={v.id}>{v.nombre} ({cargas.get(v.id) ?? 0})</option>
                  ))}
                </select>
                <button class="btn btn-primary btn-sm" type="submit">
                  <Icon name="user-check" size={14} /> Admitir
                </button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
  <p class="mt-3 text-xs text-blue-slate">El número entre paréntesis es la cantidad de acompañamientos vigentes de cada voluntario/a.</p>
</EkrLayout>