---
import Icon from './Icon.astro';
interface Props { icon?: string; title: string; text?: string }
const { icon = 'inbox', title, text } = Astro.props;
---
<div class="flex flex-col items-center px-6 py-12 text-center">
  <span class="grid size-12 place-items-center rounded-2xl bg-rosy-taupe/20 text-rose-deep"><Icon name={icon} size={22} /></span>
  <p class="mt-3 font-semibold text-ink">{title}</p>
  {text && <p class="mt-1 max-w-sm text-sm text-blue-slate">{text}</p>}
  <div class="mt-4"><slot /></div>
</div>
